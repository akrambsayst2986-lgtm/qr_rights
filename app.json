{
  "expo": {
    "name": "QR Rights",
    "slug": "qr-rights",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png", // ← تأكد من وجود icon.png
    "userInterfaceStyle": "dark",
    // تم حذف قسم splash هنا
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.qrrights.app",
      "infoPlist": {
        "NSCameraUsageDescription": "نحتاج الوصول للكاميرا لمسح QR Code",
        "NSPhotoLibraryUsageDescription": "نحتاج الوصول للصور لقراءة QR Code"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png", // ← تأكد من وجود adaptive-icon.png
        "backgroundColor": "#0f3460"
      },
      "package": "com.qrrights.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png" // ← تأكد من وجود favicon.png
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "نحتاج الوصول للكاميرا"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج الوصول للصور"
        }
      ]
    ]
  }
}
